# Copiar a .env para desarrollo local (no se sube a git).
# En Render, estas mismas claves se cargan como variables de entorno del servicio.

# Clave para firmar la sesión de login. Generar una random y larga, ej:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-random

# Cadena de conexión a la base Postgres de Neon (Settings > Connection string).
# Si se deja vacía, la app usa un sqlite local (liqui_dado.db) para desarrollar.
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/liqui_dado?sslmode=require

# Envío de emails (link de "olvidé mi contraseña"). Sirve cualquier proveedor
# SMTP; se recomienda Resend (resend.com) por su plan gratis permanente.
# Si se dejan vacías, el link se imprime por consola en vez de mandarse por
# email — cómodo para probar en desarrollo sin tener una cuenta todavía.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=tu-api-key-de-resend
EMAIL_FROM=app-liquidar <noreply@tudominio.com>

# Admin inicial (solo hace falta en Render, que no tiene Shell/SSH en el
# plan gratis para correr `flask crear-admin` a mano). Si no existe ningún
# admin todavía, se crea uno con estos datos al arrancar la app. Local no
# hace falta completar esto: usá `flask --app app crear-admin` en la
# terminal en su lugar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
